rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read:  if request.auth.uid == userId || isStaff();
      allow write: if request.auth.uid == userId;
    }

    match /cars/{carId} {
      allow read:           if request.auth.uid == resource.data.userId || isStaff();
      allow create:         if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    match /bookings/{bookingId} {
      allow create:       if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth.uid == resource.data.userId || isStaff();
      allow delete:       if false;
    }

    match /repairs/{repairId} {
      allow read:   if request.auth.uid == resource.data.userId || isStaff();
      allow create: if isStaff();
      allow update: if isStaff()
                       // consent: เจ้าของรถแก้ได้เฉพาะ field approval/timeline/updatedAt (TC-02 consent)
                       || (request.auth.uid == resource.data.userId
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['approval', 'timeline', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // TC-X09: ป้องกันการป่วนคิว — ห้ามแก้ max, ห้ามลดจำนวน booked, แก้ได้เฉพาะ booked/updatedAt
    match /slots/{date} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked','updatedAt'])
                       && request.resource.data.booked is int
                       && request.resource.data.booked >= resource.data.booked
                       && request.resource.data.booked <= resource.data.max;
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update: if request.auth.uid == resource.data.userId || isStaff();
      // B12 FIX: เพิ่ม userId check เพื่อป้องกัน user สร้าง notif ให้คนอื่น
      allow create: if isStaff() ||
        (request.auth != null &&
         request.resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /staff/{staffId} {
      allow read:   if request.auth.uid == staffId || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // TC-X10: เปิดให้อ่านบทความที่เผยแพร่แล้วได้แบบ public (ไม่ต้องล็อกอิน)
    match /articles/{articleId} {
      allow read:           if resource.data.published == true || isStaff();
      allow create, update: if isStaff();
      allow delete:         if isAdmin();
    }

    match /config/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    function isStaff() {
      let s = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return s != null && s.data.role in ['admin', 'mechanic'];
    }
    function isAdmin() {
      let s = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return s != null && s.data.role == 'admin';
    }
  }
}
